{
  "manifest_version": 3,
  "name": "WikiES — Traducir artículos de Wikipedia al español",
  "version": "0.2.0",
  "description": "Detecta artículos de la Wikipedia en inglés, portugués o francés sin versión en español y genera un wikitexto traducido, editable y listo para pegar.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "WikiES — Opciones",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://en.wikipedia.org/*",
    "https://pt.wikipedia.org/*",
    "https://fr.wikipedia.org/*",
    "https://es.wikipedia.org/*",
    "https://api.openai.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://en.wikipedia.org/wiki/*",
        "https://pt.wikipedia.org/wiki/*",
        "https://fr.wikipedia.org/wiki/*"
      ],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "src/options.html"
}
